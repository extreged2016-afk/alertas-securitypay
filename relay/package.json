{
  "name": "@securitypay/relay",
  "version": "0.2.0",
  "description": "securitypay relay: pairing, events, push and call signalling",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:types": "openapi-typescript ../protocol/relay.openapi.yaml -o src/generated/api.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "livekit-server-sdk": "2.19.1",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "ws": "^8.22.0"
  }
}
